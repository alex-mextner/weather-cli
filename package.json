{
  "name": "weather-cli",
  "version": "0.1.0",
  "description": "Weather in human Russian: decision functions that turn raw forecast data into short spoken phrases, plus a CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-mextner/weather-cli.git"
  },
  "bin": {
    "weather": "bin/weather"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
